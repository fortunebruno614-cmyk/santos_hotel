# Shared development baseline (committed — dev-only credentials, never real secrets).
# Per-machine overrides go in .env.local (git-ignored, loaded with higher priority).
# Baseline uses the Docker Postgres from docker-compose.yml:
DATABASE_URL="postgresql://santos:santos@127.0.0.1:5432/santos_hotel"
# Per-pool socket cap (src/lib/prisma.ts). pg defaults to 10 per pool, and the
# app creates one pool per bundled copy (RSC, SSR, route handlers) — left uncapped
# that outruns the dev Postgres connection limit and connections get dropped
# mid-query with "Server has closed the connection". PGlite queues queries anyway,
# so a small pool costs no throughput.
DATABASE_POOL_MAX=4
NEXT_PUBLIC_MAP_DEMO_LOCATION=false
