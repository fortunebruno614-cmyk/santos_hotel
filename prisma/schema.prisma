// Santo Hotel — Phase 2 domain model
// Docs: https://pris.ly/d/prisma-schema
// Migration order plan: docs/DEVELOPMENT_PLAN.md → P2.2

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  GUEST
}

/// Active/inactive flag used by configuration entities (room types, rates, promotions).
enum RecordStatus {
  ACTIVE
  INACTIVE
}

/// Operational condition of a physical room.
enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

/// How a promotion discount is calculated.
enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Reservation lifecycle.
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

/// Financial transaction lifecycle (independent of booking status).
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Delivery channel for guest/staff messages.
enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

/// Delivery state of a notification.
enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OrganizationStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrganizationRole {
  OWNER
  MANAGER
  STAFF
}

enum MemberStatus {
  INVITED
  ACTIVE
  REVOKED
}

enum PlatformRole {
  SUPPORT
  OPERATIONS
  ADMIN
}

enum PropertyPublicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PUBLISHED
  PAUSED
  SUSPENDED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum LocationVerification {
  NONE
  PLATFORM_VERIFIED
}

enum LocationPrecision {
  NONE
  APPROXIMATE
  NEIGHBORHOOD
  EXACT
}

enum RecordScope {
  PLATFORM
  TENANT
}

// ---------------------------------------------------------------------------
// Tenant organization and membership foundation.
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(PROVISIONING)
  email     String?
  phone     String?
  country   String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  hotels        Hotel[]
  members       OrganizationMember[]
  roomTypes     RoomType[]
  amenities     Amenity[]
  content       SiteContent[]
  bookings      Booking[]
  payments      Payment[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  invitedById    String?          @map("invited_by_user_id") @db.Uuid
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz()
  activatedAt    DateTime?        @map("activated_at") @db.Timestamptz()
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz()
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotels       OrganizationMemberHotel[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

model OrganizationMemberHotel {
  memberId String @map("member_id") @db.Uuid
  hotelId  String @map("hotel_id") @db.Uuid

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  hotel  Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([memberId, hotelId])
  @@index([hotelId])
  @@map("organization_member_hotels")
}

model Hotel {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  slug           String  @unique
  description    String?
  phone          String?
  email          String?
  addressLine1   String? @map("address_line1")
  addressLine2   String? @map("address_line2")
  city           String?
  postcode       String?
  country        String?
  timezone       String  @default("Asia/Kuala_Lumpur")
  currency       String  @default("NGN")

  /// Verified location for the public room map (MR-07). Set only by an
  /// authorized operator from a verified source; NULL (both columns, enforced
  /// by a DB check) means the map shows "Map location unavailable" instead of
  /// a guessed pin. Never geocode an ambiguous address in production.
  latitude  Decimal? @map("latitude") @db.Decimal(9, 6)
  longitude Decimal? @map("longitude") @db.Decimal(10, 6)

  publicationStatus    PropertyPublicationStatus @default(DRAFT) @map("publication_status")
  verificationStatus   VerificationStatus        @default(UNVERIFIED) @map("verification_status")
  locationVerification LocationVerification      @default(NONE) @map("location_verification")
  locationPrecision    LocationPrecision         @default(NONE) @map("location_precision")
  verifiedAt           DateTime?                 @map("verified_at") @db.Timestamptz()
  verifiedById         String?                   @map("verified_by_user_id") @db.Uuid

  // P7 system settings — the admin console edits these; `src/config/booking.ts`
  // env vars are only the bootstrap fallback for a database that has none.
  checkInTime              String  @default("15:00") @map("check_in_time")
  checkOutTime             String  @default("11:00") @map("check_out_time")
  taxRatePercent           Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)
  serviceFee               Decimal @default(0) @map("service_fee") @db.Decimal(10, 2)
  cancellationWindowHours  Int     @default(48) @map("cancellation_window_hours")
  guestCancellationEnabled Boolean @default(true) @map("guest_cancellation_enabled")
  maxRoomsPerBooking       Int     @default(10) @map("max_rooms_per_booking")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verifiedBy          User?                     @relation("HotelVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  roomTypes           RoomType[]
  rooms               Room[]
  bookings            Booking[]
  bookingRooms        BookingRoom[]
  roomNights          RoomNight[]
  payments            Payment[]
  notifications       Notification[]
  promotions          Promotion[]
  memberHotels        OrganizationMemberHotel[]
  listingReviews      ListingReview[]
  publicSlugRedirects PublicSlugRedirect[]
  content             SiteContent[]
  auditLogs           AuditLog[]

  @@index([organizationId])
  @@index([publicationStatus, id])
  @@map("hotels")
}

model ListingReview {
  id             String                    @id @default(uuid()) @db.Uuid
  hotelId        String                    @map("hotel_id") @db.Uuid
  fromStatus     PropertyPublicationStatus @map("from_status")
  toStatus       PropertyPublicationStatus @map("to_status")
  decisionReason String?                   @map("decision_reason")
  reviewerUserId String?                   @map("reviewer_user_id") @db.Uuid
  decidedAt      DateTime                  @default(now()) @map("decided_at") @db.Timestamptz()

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, decidedAt])
  @@map("listing_reviews")
}

model PublicSlugRedirect {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  fromSlug   String   @map("from_slug")
  hotelId    String   @map("hotel_id") @db.Uuid
  targetSlug String   @map("target_slug")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([entityType, fromSlug])
  @@index([hotelId])
  @@map("public_slug_redirects")
}

// ---------------------------------------------------------------------------
// 016 — Website content (P7: marketing copy edited from the admin console).
// ---------------------------------------------------------------------------

model SiteContent {
  /// Stable slot id the public site renders from, e.g. `home.hero`, `rooms.intro`.
  key            String      @id
  scope          RecordScope @default(PLATFORM)
  organizationId String?     @map("organization_id") @db.Uuid
  hotelId        String?     @map("hotel_id") @db.Uuid
  title          String?
  body           String      @default("")
  updatedById    String?     @map("updated_by_user_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  updatedBy    User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hotel        Hotel?        @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@map("site_content")
}

// ---------------------------------------------------------------------------
// 002 — Authenticated staff/admin accounts.
// ---------------------------------------------------------------------------

model User {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole      @default(STAFF)
  platformRole PlatformRole? @map("platform_role")
  isActive     Boolean       @default(true) @map("is_active")
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  bookingsCreated         Booking[]            @relation("BookingCreatedBy")
  auditLogs               AuditLog[]
  siteContent             SiteContent[]
  organizationMemberships OrganizationMember[]
  verifiedHotels          Hotel[]              @relation("HotelVerifiedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// 003 — Guests (customers associated with reservations).
// ---------------------------------------------------------------------------

model Guest {
  id           String    @id @default(uuid()) @db.Uuid
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String?   @unique
  phone        String?
  idType       String?   @map("id_type")
  idNumber     String?   @map("id_number")
  passwordHash String?   @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  bookings Booking[]

  @@index([email])
  @@map("guests")
}

// ---------------------------------------------------------------------------
// 004 — Room types (accommodation categories).
// ---------------------------------------------------------------------------

model RoomType {
  id             String       @id @default(uuid()) @db.Uuid
  hotelId        String       @map("hotel_id") @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  name           String       @unique
  slug           String       @unique
  description    String?
  maxAdults      Int          @map("max_adults")
  maxChildren    Int          @default(0) @map("max_children")
  basePrice      Decimal      @map("base_price") @db.Decimal(10, 2)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  hotel        Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rooms        Room[]
  rates        Rate[]
  images       RoomImage[]
  amenities    RoomTypeAmenity[]

  @@unique([id, hotelId])
  @@index([hotelId])
  @@index([hotelId, status])
  @@map("room_types")
}

// ---------------------------------------------------------------------------
// 005 — Physical hotel rooms (inventory).
// ---------------------------------------------------------------------------

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  roomTypeId String     @map("room_type_id") @db.Uuid
  hotelId    String?    @map("hotel_id") @db.Uuid
  roomNumber String     @unique @map("room_number")
  floor      Int?
  status     RoomStatus @default(AVAILABLE)
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  hotel    Hotel?   @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  bookingRooms BookingRoom[]
  roomNights   RoomNight[]

  @@unique([id, hotelId])
  // P2.3: (room_type_id) — rooms per category: `WHERE room_type_id = $1`.
  //        (status) — housekeeping/front-desk board: `WHERE status = 'AVAILABLE'`.
  @@index([roomTypeId])
  @@index([status])
  @@map("rooms")
}

// ---------------------------------------------------------------------------
// 006 — Reusable room features (many-to-many with room types).
// ---------------------------------------------------------------------------

model Amenity {
  id             String      @id @default(uuid()) @db.Uuid
  scope          RecordScope @default(PLATFORM)
  organizationId String?     @map("organization_id") @db.Uuid
  name           String      @unique
  description    String?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roomTypes    RoomTypeAmenity[]

  @@map("amenities")
}

model RoomTypeAmenity {
  roomTypeId String @map("room_type_id") @db.Uuid
  amenityId  String @map("amenity_id") @db.Uuid

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

// ---------------------------------------------------------------------------
// Room media (category photography).
// ---------------------------------------------------------------------------

model RoomImage {
  id         String   @id @default(uuid()) @db.Uuid
  roomTypeId String   @map("room_type_id") @db.Uuid
  url        String
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@map("room_images")
}

// ---------------------------------------------------------------------------
// 007 — Rates (price applicable to a room type and period).
// ---------------------------------------------------------------------------

model Rate {
  id         String       @id @default(uuid()) @db.Uuid
  roomTypeId String       @map("room_type_id") @db.Uuid
  name       String
  amount     Decimal      @db.Decimal(10, 2)
  currency   String       @default("NGN")
  startDate  DateTime     @map("start_date") @db.Date
  endDate    DateTime     @map("end_date") @db.Date
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@index([startDate, endDate])
  @@map("rates")
}

// ---------------------------------------------------------------------------
// 011 — Promotions (discount rules).
// ---------------------------------------------------------------------------

model Promotion {
  id        String        @id @default(uuid()) @db.Uuid
  hotelId   String?       @map("hotel_id") @db.Uuid
  code      String        @unique
  type      PromotionType
  value     Decimal       @db.Decimal(10, 2)
  startAt   DateTime      @map("start_at") @db.Timestamptz()
  endAt     DateTime      @map("end_at") @db.Timestamptz()
  maxUses   Int?          @map("max_uses")
  status    RecordStatus  @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  hotel    Hotel?    @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([status])
  @@map("promotions")
}

// ---------------------------------------------------------------------------
// 008 — Bookings (reservation header and commercial record).
// ---------------------------------------------------------------------------

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  hotelId          String?       @map("hotel_id") @db.Uuid
  organizationId   String?       @map("organization_id") @db.Uuid
  currency         String?
  termsSnapshot    Json?         @map("terms_snapshot")
  bookingReference String        @unique @map("booking_reference")
  guestId          String        @map("guest_id") @db.Uuid
  promotionId      String?       @map("promotion_id") @db.Uuid
  promotionCode    String?       @map("promotion_code")
  checkIn          DateTime      @map("check_in") @db.Date
  checkOut         DateTime      @map("check_out") @db.Date
  adults           Int           @default(1)
  children         Int           @default(0)
  subtotal         Decimal       @default(0) @db.Decimal(10, 2)
  taxes            Decimal       @default(0) @db.Decimal(10, 2)
  fees             Decimal       @default(0) @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @default(0) @db.Decimal(10, 2)
  bookingStatus    BookingStatus @default(PENDING) @map("booking_status")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  notes            String?
  createdByUserId  String?       @map("created_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  hotel         Hotel?         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  guest         Guest          @relation(fields: [guestId], references: [id], onDelete: Restrict)
  promotion     Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rooms         BookingRoom[]
  roomNights    RoomNight[]
  payments      Payment[]
  notifications Notification[]

  @@unique([id, hotelId])
  // P2.3 index justifications (query each one serves):
  // booking_reference unique — `SELECT * FROM bookings WHERE booking_reference = $1`
  //   (guest "find my booking", staff search, payment-webhook correlation).
  // (guest_id) — guest booking history: `WHERE guest_id = $1 ORDER BY created_at DESC`.
  // (check_in, check_out) — covers every check_in lookup via prefix (date ranges,
  //   arrivals calendar) plus the availability overlap predicate
  //   `check_in < $requested_out AND check_out > $requested_in`.
  // (check_out) — departures list: `WHERE check_out = CURRENT_DATE`.
  // (booking_status, check_in, check_out) — overlap query restricted to live
  //   bookings (`booking_status IN (...) AND check_in < $out AND check_out > $in`);
  //   leading column also covers plain `WHERE booking_status = $1` lookups, so no
  //   separate booking_status index is needed.
  @@index([guestId])
  @@index([checkIn, checkOut])
  @@index([checkOut])
  @@index([bookingStatus, checkIn, checkOut])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// 009 — Booking rooms (physical room allocation per booking, with historical
// pricing).
// ---------------------------------------------------------------------------

model BookingRoom {
  id                   String   @id @default(uuid()) @db.Uuid
  hotelId              String?  @map("hotel_id") @db.Uuid
  roomTypeNameSnapshot String?  @map("room_type_name_snapshot")
  roomTypeSlugSnapshot String?  @map("room_type_slug_snapshot")
  bookingId            String   @map("booking_id") @db.Uuid
  roomId               String   @map("room_id") @db.Uuid
  nightlyRate          Decimal  @map("nightly_rate") @db.Decimal(10, 2)
  nights               Int
  roomTotal            Decimal  @map("room_total") @db.Decimal(10, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  // P2.3 index justifications:
  // unique (booking_id, room_id) — allocation lookup per booking:
  //   `SELECT * FROM booking_rooms WHERE booking_id = $1` (prefix) and it
  //   enforces one allocation per room per booking.
  // (room_id, booking_id) — overlap/exclusion half of the availability query:
  //   `SELECT booking_id FROM booking_rooms WHERE room_id = ANY($rooms)`
  //   (covers booking_id so the scan can be index-only); the joined bookings
  //   side is served by bookings (booking_status, check_in, check_out).
  @@unique([bookingId, roomId])
  @@index([roomId, bookingId])
  @@map("booking_rooms")
}

// ---------------------------------------------------------------------------
// 015 — Room nights (P4 availability ledger: one row per room per sold night).
// ---------------------------------------------------------------------------

model RoomNight {
  /// Calendar night the room is sold (date-only; `[check_in, check_out)`).
  night     DateTime @db.Date
  roomId    String   @map("room_id") @db.Uuid
  hotelId   String?  @map("hotel_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)
  hotel   Hotel?  @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  // P4 — the database-level double-booking guard. PRIMARY KEY (room_id, night)
  //   makes "two live bookings hold the same room for the same night" a
  //   constraint violation, no matter which code path tried to write it. Half-open
  //   `[check_in, check_out)` nights are what makes same-day turnover (one guest
  //   out, the next in on the same date) legal by construction — see
  //   docs/OPEN_QUESTIONS.md #8. A `booking_rooms` row exists without nights only
  //   while the booking is cancelled (trigger) or its unpaid Pending hold expired
  //   (src/server/availability), i.e. exactly when inventory is free.
  // (booking_id) — release sweep: `DELETE FROM room_nights WHERE booking_id = ANY($1)`
  //   and the cascade on booking deletion.
  @@id([roomId, night])
  @@index([bookingId])
  @@index([hotelId, night])
  @@map("room_nights")
}

// ---------------------------------------------------------------------------
// 010 — Payments (financial transactions; provider references only, never card
// numbers).
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  hotelId           String?       @map("hotel_id") @db.Uuid
  organizationId    String?       @map("organization_id") @db.Uuid
  bookingId         String        @map("booking_id") @db.Uuid
  provider          String
  providerReference String?       @unique @map("provider_reference")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("NGN")
  status            PaymentStatus @default(PENDING)
  refundedAmount    Decimal       @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz()
  refundedAt        DateTime?     @map("refunded_at") @db.Timestamptz()
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  hotel        Hotel?        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// 012 — Notifications (messages sent to guests or staff).
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  hotelId        String?             @map("hotel_id") @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  bookingId      String?             @map("booking_id") @db.Uuid
  channel        NotificationChannel
  recipient      String
  subject        String?
  body           String
  status         NotificationStatus  @default(PENDING)
  error          String?
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz()
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz()

  hotel        Hotel?        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// 014 — Audit logs (history of important administrative actions).
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  hotelId        String?  @map("hotel_id") @db.Uuid
  actorType      String?  @map("actor_type")
  actorGuestId   String?  @map("actor_guest_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  purpose        String?
  outcome        String?
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  oldValues      Json?    @map("old_values")
  newValues      Json?    @map("new_values")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  hotel        Hotel?        @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId, hotelId, createdAt])
  @@map("audit_logs")
}
