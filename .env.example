# Copy to `.env` and adjust for your setup.

# Option A — Homebrew Postgres (this machine)
DATABASE_URL="postgresql://mac@127.0.0.1:5432/santos_hotel"

# Option B — Docker Postgres (docker compose up -d)
# DATABASE_URL="postgresql://santos:santos@127.0.0.1:5432/santos_hotel"

# --- P3 Auth & Authorization ------------------------------------------------
# Signs the session JWT (src/server/auth/session.ts). REQUIRED in production:
# the app refuses to sign or verify sessions without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# Guest accounts (docs/OPEN_QUESTIONS.md #13 is still open - these are the
# smallest reversible defaults, not a decision):
#   GUEST_ACCOUNTS_ENABLED=true            set false to turn off guest sign-up
#   GUEST_BOOKING_REQUIRES_ACCOUNT=false   P5 reads this when checkout exists
