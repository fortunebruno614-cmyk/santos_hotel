# Copy to `.env` and adjust for your setup.

# Option A — Homebrew Postgres (this machine)
DATABASE_URL="postgresql://mac@127.0.0.1:5432/santos_hotel"

# Option B — Docker Postgres (docker compose up -d)
# DATABASE_URL="postgresql://santos:santos@127.0.0.1:5432/santos_hotel"

# Per-pool socket cap for Prisma (src/lib/prisma.ts). pg defaults to 10 per
# pool and the app opens one pool per bundled server copy, so the uncapped
# total can exceed the dev Postgres connection limit and get connections
# dropped mid-query ("Server has closed the connection"). Keep it small:
#   DATABASE_POOL_MAX=4

# --- P3 Auth & Authorization ------------------------------------------------
# Signs the session JWT (src/server/auth/session.ts). REQUIRED in production:
# the app refuses to sign or verify sessions without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# Guest accounts (docs/OPEN_QUESTIONS.md #13 is still open - these are the
# smallest reversible defaults, not a decision):
#   GUEST_ACCOUNTS_ENABLED=true            set false to turn off guest sign-up
#   GUEST_BOOKING_REQUIRES_ACCOUNT=false   P5 reads this when checkout exists

# --- P4 Availability engine (docs/OPEN_QUESTIONS.md #8, #15, #20 - still open,
#     these are the smallest reversible defaults, not a decision):
#   ALLOW_SAME_DAY_TURNOVER=true     true = half-open nights (back-to-back legal);
#                                    false = the checkout date stays blocked
#   PENDING_HOLD_MINUTES=60          unpaid PENDING bookings hold rooms this long
#   CHILDREN_COUNT_AS_ADULTS=false   false = children fit against max_children

# --- P5 Booking & checkout (docs/OPEN_QUESTIONS.md #2-#3, #7, #9 - still open,
#     these are the smallest reversible defaults, not a decision):
#   HOTEL_CURRENCY=NGN               currency amounts are stored and charged in
#                                    (#1 answered: Naira). Guests may view the
#                                    site in NGN or USD - display only.
#   TAX_RATE_PERCENT=0               0 = no tax line until taxes are confirmed
#   SERVICE_FEE=0                    flat fee charged once per booking
#   CHECK_IN_TIME=15:00              shown to guests; anchors the cancellation deadline
#   CHECK_OUT_TIME=11:00             shown to guests
#   CANCELLATION_WINDOW_HOURS=48     guests may cancel free until this long before check-in
#   GUEST_CANCELLATION_ENABLED=true  false = only staff may cancel
#   MAX_ROOMS_PER_BOOKING=10         technical cap on rooms per reservation

# --- P6 Payments (docs/OPEN_QUESTIONS.md #4-#6 - still open, these are the
#     smallest reversible defaults, not a decision):
#   PAYMENT_PROVIDER=mock            provider id; "mock" is a fully working local
#                                    gateway (signed webhooks, success/failure/refund).
#                                    A real gateway is one registry entry + this var.
#   PAYMENT_WEBHOOK_SECRET=          HMAC secret webhook payloads are signed with;
#                                    falls back to SESSION_SECRET. REQUIRED in production.
#   REFUND_ON_CANCELLATION=true      false = cancellation leaves money captured for
#                                    manual staff refund

# --- AI concierge (live chat, optional) ---------------------------------------
# Groq key that powers the floating chat widget (src/server/ai/*). Server-only:
# no NEXT_PUBLIC_ prefix, and a real key belongs in .env.local (git-ignored),
# never here. Without a key the widget endpoint answers 503 and the button is
# hidden — nothing else changes.
#   GROQ_API_KEY=               https://console.groq.com/keys
#   GROQ_MODEL=openai/gpt-oss-120b         any Groq chat model with tool calling
#   AI_CHAT_ENABLED=true        false turns the endpoint off even with a key
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# AI_CHAT_ENABLED=true

# --- Google Maps room map (optional) ------------------------------------------
# Browser key for the Maps JavaScript API, restricted to your site's HTTP
# referrers in Google Cloud (see docs/setup.md "Google Maps"). Without it the
# List/Map toggle is hidden and the rooms pages stay list-only — nothing breaks.
# Never commit a real key; use .env.local.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_DEMO_LOCATION=true

# --- Firebase Authentication (Google sign-in) --------------------------------
# Public web-app config (these are identifiers, not secrets). Create a Web app
# in Firebase > Project settings, enable Authentication > Google, and add your
# deployment domain under Authentication > Settings > Authorized domains.
# When omitted, src/lib/firebase/config.ts falls back to the santos-hotel-final
# project defaults; set these for staging/production.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- OpenSky Network flight tracking (optional) ------------------------------
# Server-only OAuth2 client credentials from the OpenSky account page.
# NEVER give these a NEXT_PUBLIC_ prefix: the browser only calls our own
# /api/public/flights proxy, and the token is held server-side.
#   OPENSKY_CLIENT_ID=
#   OPENSKY_CLIENT_SECRET=
#   OPENSKY_CACHE_TTL_SECONDS=120   upstream response cache (credits guard)
#   FLIGHT_BBOX_SPAN_DEG=4           regional map span around the hotel
#   FLIGHT_DEFAULT_LAT=6.426588      fallback centre when hotel has no coordinates
#   FLIGHT_DEFAULT_LON=3.429399
#   FLIGHT_DEFAULT_ZOOM=6
#   FLIGHT_MAX_AIRCRAFT=250
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Weather widget (optional; keyless) --------------------------------------
# The header chip and account dashboard use Open-Meteo through the cached
# /api/public/weather proxy. These overrides are optional.
#   WEATHER_ENABLED=false            hide the widget and disable the route
#   WEATHER_CACHE_TTL_SECONDS=900    upstream cache (15 minutes)
#   WEATHER_DEFAULT_LAT=6.426588     fallback when the hotel has no coordinates
#   WEATHER_DEFAULT_LON=3.429399
# WEATHER_ENABLED=true

# --- Resend email notifications (server-only) --------------------------------
# Create an API key at https://resend.com/api-keys. Never prefix it with
# NEXT_PUBLIC_: only src/server/notifications/* reads it. For production, verify
# a sending domain in Resend and set RESEND_FROM_EMAIL to an address on it.
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL="Santo Hotel <reservations@your-domain.com>"
#   RESEND_REPLY_TO=reservations@your-domain.com
#   HOTEL_NOTIFICATION_EMAIL=owner@your-domain.com
#   APP_URL=https://your-domain.com
#   EMAIL_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL="Santo Hotel <onboarding@resend.dev>"
