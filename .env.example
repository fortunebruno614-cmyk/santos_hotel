# Copy to `.env` and adjust for your setup.

# Option A — Homebrew Postgres (this machine)
DATABASE_URL="postgresql://mac@127.0.0.1:5432/santos_hotel"

# Option B — Docker Postgres (docker compose up -d)
# DATABASE_URL="postgresql://santos:santos@127.0.0.1:5432/santos_hotel"

# --- P3 Auth & Authorization ------------------------------------------------
# Signs the session JWT (src/server/auth/session.ts). REQUIRED in production:
# the app refuses to sign or verify sessions without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-me-with-a-long-random-string"

# Guest accounts (docs/OPEN_QUESTIONS.md #13 is still open - these are the
# smallest reversible defaults, not a decision):
#   GUEST_ACCOUNTS_ENABLED=true            set false to turn off guest sign-up
#   GUEST_BOOKING_REQUIRES_ACCOUNT=false   P5 reads this when checkout exists

# --- P4 Availability engine (docs/OPEN_QUESTIONS.md #8, #15, #20 - still open,
#     these are the smallest reversible defaults, not a decision):
#   ALLOW_SAME_DAY_TURNOVER=true     true = half-open nights (back-to-back legal);
#                                    false = the checkout date stays blocked
#   PENDING_HOLD_MINUTES=60          unpaid PENDING bookings hold rooms this long
#   CHILDREN_COUNT_AS_ADULTS=false   false = children fit against max_children

# --- P5 Booking & checkout (docs/OPEN_QUESTIONS.md #1-#3, #7, #9 - still open,
#     these are the smallest reversible defaults, not a decision):
#   HOTEL_CURRENCY=MYR               fallback currency when the hotels row has none
#   TAX_RATE_PERCENT=0               0 = no tax line until taxes are confirmed
#   SERVICE_FEE=0                    flat fee charged once per booking
#   CHECK_IN_TIME=15:00              shown to guests; anchors the cancellation deadline
#   CHECK_OUT_TIME=11:00             shown to guests
#   CANCELLATION_WINDOW_HOURS=48     guests may cancel free until this long before check-in
#   GUEST_CANCELLATION_ENABLED=true  false = only staff may cancel
#   MAX_ROOMS_PER_BOOKING=10         technical cap on rooms per reservation
